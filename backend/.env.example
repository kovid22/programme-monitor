GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_SHEET_RANGE=A3:L
# Optional for local development. Cloud Run uses Application Default Credentials.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FRONTEND_ORIGIN=http://localhost:5173
# Set to production when deploying to disable /docs, /redoc, and /openapi.json.
ENVIRONMENT=development

# Firebase Admin (Phase 2A)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional for local development. Cloud Run uses Application Default Credentials.
# Paste the full JSON of your Firebase Admin service-account key as a single line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Comma-separated list of approved user emails:
ALLOWED_EMAILS=user1@example.com,user2@example.com
